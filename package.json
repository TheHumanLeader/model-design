{
  "name": "model-design",
  "version": "0.1.0-next.0",
  "description": "A high-performance visual model designer built with Vue 3.6 Vapor Mode.",
  "type": "module",
  "license": "MIT",
  "author": "TheHumanLeader",
  "homepage": "https://github.com/TheHumanLeader/model-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHumanLeader/model-design.git"
  },
  "bugs": {
    "url": "https://github.com/TheHumanLeader/model-design/issues"
  },
  "keywords": [
    "vue",
    "vapor",
    "model-designer",
    "schema-designer",
    "visual-editor",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/model-design.js",
  "module": "./dist/model-design.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/model-design.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/types",
    "build:playground": "vite build --mode playground",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview --outDir playground-dist",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "vue": ">=3.6.0-rc.6 <4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "3.6.0-rc.6",
    "vue-tsc": "^3.3.11"
  }
}
