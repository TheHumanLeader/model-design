{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist/types"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.vue",
    "src/core/**/*.ts",
    "src/types.ts"
  ],
  "exclude": [
    "src/playground/**",
    "tests/**"
  ]
}
